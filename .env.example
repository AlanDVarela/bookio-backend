# === DATABASE CONFIGURATION ===

# Opción 1: Base de datos local (Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bookio_db?schema=public"

# Opción 2: Base de datos en la nube
# DATABASE_URL="postgresql://tu-usuario:tu-password@host-de-tu-cloud:5432/bookio_db?schema=public"

# Firebase Admin Auth

FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# AWS Configuration 
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_SESSION_TOKEN="sesion temporal"

# S3 para fotos y logos
S3_BUCKET_NAME="bookio-assets-bucket"

# SNS para notificaciones 
SNS_TOPIC_ARN="arn:aws:sns:us-east-1:123456789012:your-topic"

# Otros
PORT=3000
NODE_ENV=development
