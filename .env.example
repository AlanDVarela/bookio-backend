# =============================================================================
# Bookio Backend — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# =============================================================================

# ─── Base de Datos ────────────────────────────────────────────────────────────

# Desarrollo local (Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bookio_db?schema=public"

# Producción (RDS) — obtenida de Secrets Manager en EC2
# DATABASE_URL="postgresql://bookio_admin:PASSWORD@RDS_ENDPOINT:5432/bookio?schema=public"

# ─── Firebase Admin Auth ─────────────────────────────────────────────────────

FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# El valor debe usar \n literal (no saltos de línea reales)
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── AWS ──────────────────────────────────────────────────────────────────────

AWS_REGION="us-east-1"

# Credenciales locales (Learner's Lab — expiran cada ~4 horas)
# En EC2 estas variables NO se usan: el SDK usa LabInstanceProfile automáticamente.
# Actualiza con: bash scripts/update_credentials.sh
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_SESSION_TOKEN="your-session-token"

# ─── S3 ───────────────────────────────────────────────────────────────────────

S3_BUCKET_NAME="bookio-assets-bucket"

# ─── SQS — Cola de Citas ──────────────────────────────────────────────────────
# URL completa de la cola. Se obtiene al ejecutar setup_aws.sh.

SQS_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/bookio-appointments-queue"

# ─── SES — Correos Transaccionales ───────────────────────────────────────────
# Correo verificado en SES. En modo sandbox solo envía a correos verificados.

SES_FROM_EMAIL="noreply@tudominio.com"

# ─── Servidor ────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
