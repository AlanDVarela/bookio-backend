generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  BUSINESS_OWNER
}

enum BusinessType {
  BARBERSHOP
  SPA
  SALON
  RESTAURANT 
  MEDICAL   
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

model User {
  id         String   @id // Firebase UID
  role       Role     @default(CLIENT)
  name       String
  email      String   @unique
  phone      String?
  avatar_url String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  businesses   Business[]
  appointments Appointment[]
  reviews      Review[]
  favorites    Favorite[]
}

model Business {
  id       String       @id @default(uuid())
  owner_id String
  name     String
  type     BusinessType
  address  String?
  logo_url String?
  photos   String[]     @default([]) // Postgres array for multiple images

  latitude       Float?
  longitude      Float?
  average_rating Float  @default(0.0)
  review_count   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  services     Service[]
  schedules    Schedule[]
  blockedSlots BlockedSlot[]
  appointments Appointment[]
  reviews      Review[]
  favorites    Favorite[]
}

model Service {
  id               String   @id @default(uuid())
  business_id      String
  name             String
  duration_minutes Int
  price            Decimal  @db.Decimal(10, 2)
  photo_url        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business         Business          @relation(fields: [business_id], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  serviceSchedules ServiceSchedule[]
}

model ServiceSchedule {
  id          String   @id @default(uuid())
  service_id  String
  day_of_week Int      // 0 = Sunday ... 6 = Saturday
  start_time  String   // HH:mm
  end_time    String   // HH:mm
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([service_id, day_of_week])
}

model Schedule {
  id          String   @id @default(uuid())
  business_id String
  day_of_week Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  start_time  String // HH:mm format, e.g. "09:00"
  end_time    String // HH:mm format, e.g. "18:00"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, day_of_week])
}

model Appointment {
  id             String            @id @default(uuid())
  business_id    String
  client_id      String?           // Opcional para citas manuales (walk-ins)
  client_name    String?           // Nombre del cliente para citas manuales
  client_phone   String?           // Teléfono del cliente para citas manuales
  service_id     String
  start_datetime DateTime
  end_datetime   DateTime
  status         AppointmentStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client   User?    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [service_id], references: [id], onDelete: Cascade)
  review   Review?
}

model BlockedSlot {
  id          String   @id @default(uuid())
  business_id String
  date        String   // YYYY-MM-DD
  start_time  String?  // HH:mm — null = día completo bloqueado
  end_time    String?  // HH:mm — null = día completo bloqueado
  reason      String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
}

model Favorite {
  id          String   @id @default(uuid())
  client_id   String
  business_id String
  createdAt   DateTime @default(now())

  client   User     @relation(fields: [client_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([client_id, business_id])
}

model Review {
  id      String  @id @default(uuid())
  score   Int // 1-5 rating
  comment String?

  appointment_id String @unique
  business_id    String
  client_id      String

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  business    Business    @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client      User        @relation(fields: [client_id], references: [id], onDelete: Cascade)
}
